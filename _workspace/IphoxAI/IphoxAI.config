# IphoxAI Native R0 runtime
# Portable configuration loaded by IphoxCore.exe from its own directory.

runtime.host=127.0.0.1
runtime.port=8080
runtime.n_predict=512

runtime.resolve_timeout_ms=1000
runtime.connect_timeout_ms=1500
runtime.send_timeout_ms=5000
runtime.receive_timeout_ms=120000

# Optional owned llama-server. Disabled until paths are configured.
runtime.autostart=false
runtime.server_path=runtime\\llama-server.exe
runtime.model_path=models\\model.gguf
runtime.ctx_size=8192
runtime.gpu_layers=auto
runtime.startup_timeout_ms=120000

# Bounded in-session conversation context.
chat.max_turns=24
chat.max_bytes=65536
chat.system_prompt=You are IphoxAI, a local native AI assistant. Answer the latest user message directly and keep continuity with the available conversation history.
